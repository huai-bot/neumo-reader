{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "花笺阅读",
  "mainBinaryName": "floral-reader",
  "version": "0.1.0",
  "identifier": "com.masu.floral-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "花笺阅读",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#F2E8E0",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MA SU",
    "copyright": "MIT License",
    "shortDescription": "专注阅读的 Markdown / 文本阅读器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Viewer"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "纯文本文件",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
